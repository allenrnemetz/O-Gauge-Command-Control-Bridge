[MESSAGES CONTROL]
# W1203: logging-fstring-interpolation — f-strings in logger calls are
# intentional for readability; the bridge is not a high-throughput logging
# workload.
# W0718: broad-exception-caught — `except Exception:` is intentional
# throughout for best-effort cleanup (serial close, socket close, etc.)
# where any failure should be swallowed, not crash the bridge.
# R0903: too-few-public-methods — HA entity classes often have only one
# public method (e.g., async_press or update).
disable=W1203,W0718,W0719,R0903

[TYPECHECK]
# Home Assistant is not installed in the bridge development environment;
# these imports are only valid when the component runs inside HA.
ignored-modules=homeassistant
